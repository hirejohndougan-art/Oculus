{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The browser build (D-073): DOM libraries, JSX, and Vite's bundler
    // resolution. Vite builds; tsc only checks.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    // CSS Modules are typed by the X.module.d.css.ts beside each (css-modules.test.ts).
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "allowImportingTsExtensions": false,
    // The end-to-end tests compute codes with core's own TOTP (from its
    // sources when type checking; from its build when Playwright runs).
    "paths": { "@oculus/core": ["../core/src/index.ts"] }
  },
  "include": ["src", "e2e", "vite.config.ts", "playwright.config.ts"]
}
