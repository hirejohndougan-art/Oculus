{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Wide enough to take in core's sources for type checking; the build
    // (tsconfig.build.json) narrows it to src.
    "rootDir": "..",
    "outDir": "dist",
    // Type checking and lint read @oculus/core from its sources, so they work
    // before anything is built. The build (tsconfig.build.json) reads core's
    // built types instead; core builds first (workspaces build in name order).
    "paths": { "@oculus/core": ["../core/src/index.ts"] }
  },
  "include": ["src"]
}
